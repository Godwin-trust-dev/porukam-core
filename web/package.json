{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=\"--require ./scripts/polyfill-crypto.cjs\" vite build && npm run build:ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "preview:pwa": "VITE_API_MODE=real VITE_PWA_E2E=1 NODE_OPTIONS=\"--require ./scripts/polyfill-crypto.cjs\" vite build && vite preview --port 4174 --strictPort",
    "lighthouse:pwa": "lhci autorun",
    "msw:init": "msw init public/ --save",
    "build:ssr": "NODE_OPTIONS=\"--require ./scripts/polyfill-crypto.cjs\" vite build --ssr src/entry-prerender.tsx --outDir dist-ssr"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@porukam/core": "*",
    "@porukam/i18n": "*",
    "@porukam/ui": "*",
    "@tanstack/react-query": "5.62.7",
    "i18next": "24.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.0",
    "react-i18next": "15.4.0",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/onest": "5.1.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "msw": "2.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "2.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
