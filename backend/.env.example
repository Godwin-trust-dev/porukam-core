# Скопируй в .env и не коммить (.env уже в .gitignore).

DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Основная БД (порт из infra/compose/docker-compose.local.yml)
DATABASE_URL=postgres://porukam:porukam@localhost:5432/porukam

# Audit Vault — ОТДЕЛЬНАЯ БД (ADR-038, порт 5433 из compose)
AUDIT_DATABASE_URL=postgres://audit_vault:audit_vault@localhost:5433/audit_vault

# Redis: кеш и брокер Celery разделены (dev-setup.md §2)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0

# MinIO (S3-совместимое хранилище, dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=porukam-dev
AUDIT_VAULT_BUCKET_NAME=audit-vault-checkpoints

# Метки доверенного времени на корень суточного чекпойнта Audit Vault (ADR-135).
# fake — dev/test без сети; rfc3161 — 4 публичных TSA параллельно, кворум 2.
AUDIT_VAULT_TSA_PROVIDER=fake
# TSA_ENDPOINTS=http://tsa.swisssign.net,http://time.certum.pl,http://timestamp.sectigo.com/qualified,https://freetsa.org/tsr
# TSA_QUORUM=2
# TSA_TIMEOUT=10
# Идентификатор хоста в записи чекпойнта — осмысленное имя, не hostname.
HOST_ID=dev-local

# Mailhog (перехват SMTP, dev)
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# OTP-вход (apps.accounts, tech-spec.md §7.2): в dev код всегда фиксирован,
# в проде — оставь пустым, сгенерируется случайный 6-значный.
OTP_FIXED_CODE=111111
# ВНИМАНИЕ (ADR-201): config.settings.production с OTP_FIXED_CODE, fake-провайдерами
# и placeholder-ключами НЕ стартует. Аварийный клапан прода — PROD_ALLOW_FAKE_PROVIDERS
# (см. ADR-201); здесь, в dev, не нужен.

# Способ входа «телефон + код» (ADR-165). В проде — false (вход только через
# аккаунт Google, auth/otp/* отвечают 403 phone_login_disabled); локально
# оставляем true, иначе не войти без Google-приложения.
PHONE_LOGIN_ENABLED=true

# Envelope-шифрование ПД (common/crypto.py, docs/adr/ADR-059-*.md).
# Сгенерировать свой: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENVELOPE_MASTER_KEY=change-me-32-bytes-base64-per-environment

# Хеширование телефонной книги (apps.social, docs/tasks/etap-3-delta-adr059.md
# Р8) — "пепел" HMAC, свой на каждое окружение.
PHONEBOOK_HASH_PEPPER=change-me-per-environment

# Базовый URL публичного веб-приложения — GET /users/me/reputation-link
# (apps.social, заглушка-URL, etap-3.md 3.3).
PUBLIC_WEB_BASE_URL=http://localhost:5173

# --- Наблюдаемость (docs/tasks/fundament-2.md ЭФ.6) ---
# Уровень корневого логгера (common/logging.py) — JSON во всех процессах.
LOG_LEVEL=INFO
# Порог "недоставки" юрзначимого уведомления для алёрта
# (apps/notifications/metrics.py) — created без placed_in_cabinet_at дольше
# этого числа минут.
NOTIFICATIONS_UNDELIVERED_ALERT_MINUTES=60
# ADR-156: окно схлопывания правок материалов этапа в согласовании (минуты).
# Пачка правок одного человека по одному этапу = одна карточка второй стороне.
NOTIFICATIONS_MATERIALS_CHANGE_DEBOUNCE_MINUTES=10
# Очереди Celery, чью глубину (LLEN брокера) экспортирует /metrics
# (common/metrics.py:CeleryQueueCollector).
CELERY_METRICS_QUEUES=celery

# --- Доказательства: хранилище и WORM (apps.evidence, ADR-136/137) ---
# fake — память процесса (тесты/локалка); s3 — бакет EVIDENCE_BUCKET_NAME.
# С ADR-136 оригиналы хранятся на сервере во ВСЕХ контурах, шифротекстом.
EVIDENCE_OBJECT_STORE=fake
EVIDENCE_BUCKET_NAME=evidence-originals
# Режим неизменяемости ОБОИХ WORM-хранилищ (оригиналы + чекпойнты Vault):
# object_lock — S3 Object Lock (MinIO `mc mb --with-lock`); bucket_lock —
# Cloudflare R2 Bucket Lock (правило на бакет, прод); none — dev.
WORM_MODE=none
# Срок Object Lock объекта-оригинала (только object_lock), дней от загрузки.
EVIDENCE_WORM_RETENTION_DAYS=1200
# Приём подписанных DeviceKey-манифестов (серверная половина Э6; включать
# с выходом Р1-мобайл, Э10).
EVIDENCE_DEVICE_MANIFEST_ENABLED=false
# Cache-Control публичного GET /v1/evidence/retention-policy, секунд.
EVIDENCE_RETENTION_POLICY_CACHE_SECONDS=3600

# --- Архив сделки: доказательный пакет и ссылки (apps.archive, ADR-139/137) ---
# fake — память процесса (тесты/локалка); s3 — бакет ARCHIVE_BUCKET_NAME (не WORM).
ARCHIVE_OBJECT_STORE=fake
ARCHIVE_BUCKET_NAME=archive-exports
# Порог вложения письма с пакетом (байт); крупнее — только ссылка.
ARCHIVE_EMAIL_ATTACHMENT_MAX_BYTES=20971520
# База долгоживущих ссылок `/a/<token>` (по умолчанию = PUBLIC_WEB_BASE_URL).
# ARCHIVE_LINK_BASE_URL=
# Рейт-лимит ручки без авторизации, обращений на адрес за окно (сек).
ARCHIVE_LINK_RATE_LIMIT=60
ARCHIVE_LINK_RATE_WINDOW_SECONDS=600

# --- Google Drive BYO-бэкап (apps.evidence + apps.accounts, ADR-084) ---
# fake — тесты/локалка (дефолт, не менять локально); real — прод.
EVIDENCE_DRIVE_PROVIDER=fake
# OAuth-клиент общий со входом (ADR-071) — заводится в Google Console,
# Drive API включена, scope=drive.file (claude/Инструкция_Google_OAuth_Drive_setup.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Отдельный redirect для Drive-connect callback (не редирект логина).
GOOGLE_DRIVE_CONNECT_REDIRECT_URI=http://localhost:5173/settings/drive/callback

# --- Вход через Google, реальный провайдер (ГВ.2) ---
# fake — тесты/локалка (дефолт, не менять локально); real — прод.
GOOGLE_LOGIN_PROVIDER=fake
# Отдельный redirect для логина (не Drive-connect выше).
GOOGLE_OAUTH_LOGIN_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Аналитика: воронка установки приложения (apps.analytics, ADR-171) ---
# Хранение слоя событий установки, дней. То же окно, что у шагов конструктора:
# слой существует ровно на условии, что он не копится вечно.
ANALYTICS_INSTALL_RETENTION_DAYS=90
# Приёмник POST /v1/analytics/install-event открыт АНОНИМНО (приложение ставят
# до регистрации), поэтому лимит по адресу обязателен: событий на адрес за окно.
# В ключе кеша — хеш адреса, сам адрес нигде не хранится.
ANALYTICS_INSTALL_RATE_LIMIT=60
ANALYTICS_INSTALL_RATE_WINDOW_SECONDS=3600
